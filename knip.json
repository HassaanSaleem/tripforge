{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tests/integration/*.mjs",
        "tests/live/collect-evidence.mjs",
        "scenarios/incubating/*/scenario.mjs",
        "scripts/kitchenloop/derive-coverage.mjs"
      ]
    },
    "apps/web": {
      "entry": ["app/**/{page,layout,route,loading,error,not-found}.{ts,tsx}", "lib/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "packages/*": {
      "project": ["src/**/*.ts"]
    }
  }
}

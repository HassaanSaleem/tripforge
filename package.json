{
  "name": "tripforge",
  "private": true,
  "version": "0.0.0",
  "description": "TripForge — AI-native itinerary platform (monorepo root)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "depcruise": "depcruise packages apps --config .dependency-cruiser.cjs",
    "knip": "knip",
    "duplication": "jscpd packages apps",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.17.0",
    "dependency-cruiser": "^16.5.0",
    "eslint": "^9.15.0",
    "jscpd": "^4.0.5",
    "knip": "^5.36.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
